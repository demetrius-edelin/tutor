# Copy this file to .env and fill in the values. Git does not track .env.
# A value in .env replaces the same variable from your shell. An empty value changes nothing.

# The provider of the model: anthropic, openai, openrouter, or google.
# google is the Gemini API, with a key from Google AI Studio.
LLM_PROVIDER=

# The model name, exactly as the provider writes it.
# For OpenRouter, use the form vendor/model. For Google, use the model name with no prefix.
LLM_MODEL=

# The reasoning level of the model: none, minimal, low, medium, high, xhigh, or max.
# Leave it empty to use the default of the model.
# Each model accepts only some of these values. If the model does not accept the value,
# the tutor shows the error message of the provider. For Google, xhigh and max become high.
LLM_REASONING=

# OpenRouter only: the providers that can serve the model, in order, separated by commas.
# For example: deepinfra,together or deepinfra/turbo. Leave it empty to let OpenRouter select.
# The tutor sends no request to other providers. If no listed provider serves the model, the request fails.
# To find the provider names, open the model page on openrouter.ai and copy the names from the provider list.
OPENROUTER_PROVIDERS=

# The API key of the provider. The tutor uses only the key of the selected provider.
# GEMINI_API_KEY is the key of the Gemini API, from Google AI Studio. It also serves VIDEO_PROVIDER=google.
# An OpenRouter key or a Gemini key can serve the main model and the video model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Videos only. The main model cannot read video, so YouTube videos use a second model, the video model.
# Only Gemini models read YouTube videos. Leave these values empty if you do not use videos.
# The provider of the video model: openrouter or google.
# With openrouter, the tutor uses OPENROUTER_API_KEY. With google, it uses GEMINI_API_KEY.
VIDEO_PROVIDER=

# The video model name, exactly as the video provider writes it.
# For OpenRouter, use the form google/model. For Google, use the model name with no prefix.
VIDEO_MODEL=

