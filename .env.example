# Copy this file to .env and fill in the values. Git does not track .env.
# A value in .env replaces the same variable from your shell. An empty value changes nothing.

# The provider of the model: anthropic, openai, or openrouter.
LLM_PROVIDER=

# The model name, exactly as the provider writes it.
# For OpenRouter, use the form vendor/model.
LLM_MODEL=

# The reasoning level of the model: none, minimal, low, medium, high, xhigh, or max.
# Leave it empty to use the default of the model.
# Each model accepts only some of these values. If the model does not accept the value,
# the tutor shows the error message of the provider.
LLM_REASONING=

# OpenRouter only: the providers that can serve the model, in order, separated by commas.
# For example: deepinfra,together or deepinfra/turbo. Leave it empty to let OpenRouter select.
# The tutor sends no request to other providers. If no listed provider serves the model, the request fails.
# To find the provider names, open the model page on openrouter.ai and copy the names from the provider list.
OPENROUTER_PROVIDERS=

# The API key of the provider. The tutor uses only the key of the selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
