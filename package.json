{
  "name": "tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse": "tsx src/cli/parse.ts",
    "llm:check": "tsx src/cli/llm-check.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "refresh": "tsx src/cli/refresh.ts",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:app": "vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "entities": "^4.5.0",
    "fastify": "^5.12.5",
    "jszip": "^3.10.2",
    "openai": "^7.27.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
